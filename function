GCD using function
#include<stdio.h>
 int GCD(int x,int y) // 20 40
 {
    int small=(x<y)?x:y;
    int gcd=1;
    for(int i=2;i<=small;i++)
    {
        if(x%i==0 && y%i==0){
            if(i>gcd)
               gcd = i;
      }
   }
   return gcd;
 }
 int main() {
    int x,y;
    scanf("%d %d",&x,&y);
    printf("%d",GCD(x,y));
   return 0;
 }
