#include <ctype.h>
//remove the vowels 
int main() {
    char str[200], result[200];
    int i, j = 0;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);
    str[strcspn(str, "\n")] = '\0'; 

    for(i = 0; str[i] != '\0'; i++) {
        char ch = tolower(str[i]);
